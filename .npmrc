# magicmirror expects its own sub-dependencies (moment, nunjucks...) directly
# under its own node_modules/ - it serves them as static <script> globals by
# path, relative to its own directory. The default hoisting strategy moves
# them up to the project root instead, breaking that. "nested" (pre-npm3
# style: nothing hoisted) keeps every package's deps under itself.
install-strategy=nested
