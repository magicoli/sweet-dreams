{
  # Deploys MagicMirror² itself: config/ and modules/ are shared between
  # releases, they hold the local config and the third-party modules.
  import: [
    "recipe/common.php"
  ]

  config: {
    repository: "https://github.com/MagicMirrorOrg/MagicMirror.git"
    http_user: "www-data"
    remote_user: "www-data"
    shared_files: [
    ]
    shared_dirs: [
      "config"
      "modules"
    ]
  }

  # Hosts
  hosts: {
    "example.com": {
      # master is MagicMirror's latest release
      branch: "master"
      deploy_path: "~/domains/example.com/app"
    }
  }

  tasks: {
    "build": [
      { cd: "{{release_path}}" }
      { run: "source ~/.nvm/nvm.sh && npm install --omit=dev" }
      { upload: { src: "lib/MagicMirror/config/", dest: "{{deploy_path}}/shared/config/" } }
      { upload: { src: "lib/MagicMirror/modules/", dest: "{{deploy_path}}/shared/modules/" } }
    ]

    "reload": [
        { run: "sudo systemctl reload php8.4-fpm" }
        { run: "sudo systemctl restart sweet-dreams " }
    ]
  }

  after: {
    "deploy:update_code": "build"
    "deploy:publish": "reload"
    "deploy:failed": "deploy:unlock"
  }
}
