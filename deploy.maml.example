{
  # You can import other php or maml recipes.
  # Import recipes directly from recipe/ folder.
  import: [
    "recipe/common.php"
  ]

  config: {
    repository: "https://github.com/example/example.git"
    http_user: "deploy"
    remote_user: "deploy"
    identity_file: "~/.ssh/id_rsa"
    shared_files: [
      "config/config.js"
      "config/custom.css"
    ]
  }

  # Hosts
  hosts: {
    "example.com": {
      branch: "dev"
      deploy_path: "~/domains/example.com/app"
    }
  }

  tasks: {
    "magicmirror:install": [
      { desc: "Install npm dependencies (magicmirror is one of them, pinned in package.json)" }
      # Non-interactive SSH doesn't source .bashrc, so nvm's own PATH change
      # never applies - source it explicitly first.
      { run: "source .nvm/nvm.sh && cd {{release_path}} && npm install --omit=dev" }
    ]

    "sweet-dreams:restart": [
      { desc: "Restart the supervisor-managed MagicMirror process" }
      { run: "sudo supervisorctl restart sweet-dreams" }
    ]
  }

  after: {
    "deploy:update_code": "magicmirror:install"
    "deploy:publish": "sweet-dreams:restart"
    "deploy:failed": "deploy:unlock"
  }
}
